# LLM backend selector: "ollama" (local, free, dev-only) or "openrouter" (hosted, production default)
LLM_BACKEND=ollama

# Used when LLM_BACKEND=ollama
OLLAMA_MODEL=llama3.1:8b
OLLAMA_HOST=http://localhost:11434

# Used when LLM_BACKEND=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
